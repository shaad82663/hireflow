ENVIRONMENT=local
DEBUG=true
DATABASE_URL=postgresql+asyncpg://hireflow:hireflow@localhost:5432/hireflow
COMPANY_NAME=Acme Robotics
COMPANY_URL=https://example.com

# Option A: Claude on Amazon Bedrock (uses your AWS credentials from `aws configure`)
LLM_PROVIDER=bedrock_converse
LLM_MODEL=paste-the-model-or-inference-profile-id-from-the-bedrock-console
AWS_REGION=us-east-1

# Option B: OpenAI (also set OPENAI_API_KEY)
# LLM_PROVIDER=openai
# LLM_MODEL=paste-a-model-name-from-openai-docs
# OPENAI_API_KEY=sk-...